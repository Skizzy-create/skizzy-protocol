{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skizzy:capability:ksp.camera.orbit@1",
  "title": "ksp.camera.orbit",
  "description": "Sets heading, pitch and distance of the camera around its target (clamped to KSP's limits).",
  "x-skz-safety": "control",
  "x-skz-scenes": [
    "FLIGHT"
  ],
  "x-skz-affinity": "main",
  "x-skz-mcpTool": "ksp_camera_orbit",
  "input": {
    "type": "object",
    "description": "Camera orbit around the target.",
    "properties": {
      "heading": {
        "type": "number",
        "description": "degrees, 0 = camera north of target looking south, 180 = astern for a north-bound vessel",
        "minimum": -360,
        "maximum": 360,
        "x-skz-unit": "deg"
      },
      "pitch": {
        "type": "number",
        "description": "degrees above the horizon",
        "minimum": -89,
        "maximum": 89,
        "x-skz-unit": "deg"
      },
      "distance": {
        "type": "number",
        "description": "metres from the target",
        "minimum": 3,
        "maximum": 150000,
        "x-skz-unit": "m"
      }
    },
    "additionalProperties": false
  }
}
