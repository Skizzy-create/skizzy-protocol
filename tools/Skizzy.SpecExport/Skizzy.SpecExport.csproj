<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates spec/schemas from the C# catalog (Builtins) so the spec cannot drift from the code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>skizzy-spec-export</AssemblyName>
    <RootNamespace>Skizzy.SpecExport</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Skizzy.Protocol\Skizzy.Protocol.csproj" />
  </ItemGroup>
</Project>
