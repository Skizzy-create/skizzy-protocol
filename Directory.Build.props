<Project>
  <!-- Machine-specific settings (KSPDIR) come from the untracked Directory.Build.props.user
       or from the KSPDIR environment variable. Nothing machine-specific is committed. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <NoWarn>$(NoWarn);CS1591;NU1603</NoWarn>
    <Company>skizzy-protocol</Company>
    <Product>skizzy-protocol</Product>
    <Copyright>MIT licence</Copyright>
    <SkizzyVersion>0.1.0</SkizzyVersion>
    <Version>$(SkizzyVersion)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(SkizzyVersion)-m0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Keep local paths out of binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <SkizzyRepoRoot>$(MSBuildThisFileDirectory)</SkizzyRepoRoot>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
