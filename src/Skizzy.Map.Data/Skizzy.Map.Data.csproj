<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The map's data layer, free of UI: the track mirror (history rings, extrapolation), data sources (live host,
    in-process FakeKsp, the built-in demo battle ported from design/mockups/command-screen-v1.html), the session
    replay buffer, message log, losses and groups. The Avalonia app and the headless tests both use it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Skizzy.Map.Data</RootNamespace>
    <AssemblyName>Skizzy.Map.Data</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skizzy.Map.Render\Skizzy.Map.Render.csproj" />
    <ProjectReference Include="..\Skizzy.Client\Skizzy.Client.csproj" />
    <ProjectReference Include="..\Skizzy.Protocol\Skizzy.Protocol.csproj" />
    <ProjectReference Include="..\Skizzy.Sim\Skizzy.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skizzy.Map.App" />
    <InternalsVisibleTo Include="Skizzy.Map.App.Tests" />
  </ItemGroup>

</Project>
